# TinyShell Environment Configuration Template
# Copy this to .env and customize as needed
# Source it before running: source .env && ./start.sh

# ──────────────────────────────────────────────────────────────────────────────
# PostgreSQL Configuration
# ──────────────────────────────────────────────────────────────────────────────
export TSH_DB_HOST=127.0.0.1
export TSH_DB_PORT=5432
export TSH_DB_NAME=tinyshell
export TSH_DB_USER=tsh
# export TSH_DB_PASSWORD=  # Usually not needed for local socket auth

# ──────────────────────────────────────────────────────────────────────────────
# Spine Server Configuration (gRPC Job Orchestrator)
# ──────────────────────────────────────────────────────────────────────────────
export TSH_SPINE_CONTROL_PORT=7443      # Control plane endpoint
export TSH_SPINE_AGENT_PORT=7444        # Agent connection endpoint

# Job signing key (MUST be at least 32 bytes)
# BUG: literal development signing keys were copied into live deployments.
# FIX: require generated operator-provided values instead of sample secrets.
export TSH_JOB_SIGNING_KEY=""  # Run: export TSH_JOB_SIGNING_KEY=$(openssl rand -hex 32)
export TSH_JOB_KEY_ID="local-hmac-v1"

# Spine server credentials (for development/testing)
export TSH_GRPC_INSECURE_DEV=1          # Use insecure gRPC (dev only!)

# ──────────────────────────────────────────────────────────────────────────────
# Main Server Configuration
# ──────────────────────────────────────────────────────────────────────────────
export TSH_PORT=4444                    # Main server port
export TSH_API_PORT=8080                # REST API port
export TSH_API_TOKEN=""  # Run: export TSH_API_TOKEN=$(openssl rand -base64 32)
export TSH_ADMIN_TOKEN=""  # Optional: admin role token
export TSH_VIEWER_TOKEN="" # Optional: read-only role token

# ──────────────────────────────────────────────────────────────────────────────
# Worker Configuration
# ──────────────────────────────────────────────────────────────────────────────
export TSH_WORKER_PORT=5555
export TSH_WORKERS="worker-1@127.0.0.1:5555"

# ──────────────────────────────────────────────────────────────────────────────
# Audit & Security
# ──────────────────────────────────────────────────────────────────────────────
# Zookeeper secret for audit chain HMAC (persisted automatically in ~/.tsh/zk_secret)
# export TSH_ZK_SECRET=                 # Leave unset to auto-generate on first run

# Auto-trust agent TOFU (Trust On First Use)
export TSH_TOFU_AUTO_TRUST=0

# ──────────────────────────────────────────────────────────────────────────────
# Optional: TLS Certificates (for production)
# ──────────────────────────────────────────────────────────────────────────────
# API TLS: openssl req -x509 -newkey rsa:4096 -keyout certs/server.key -out certs/server.crt -days 365 -nodes -subj "/CN=tinyshell-server"
export TSH_TLS_CERT="certs/server.crt"
export TSH_TLS_KEY="certs/server.key"
# export TSH_GRPC_SERVER_CERT=/path/to/server.crt
# export TSH_GRPC_SERVER_KEY=/path/to/server.key
# export TSH_GRPC_CLIENT_CA=/path/to/ca.crt
# export TSH_GRPC_CLIENT_CERT=/path/to/client.crt
# export TSH_GRPC_CLIENT_KEY=/path/to/client.key

# ──────────────────────────────────────────────────────────────────────────────
# Usage
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Customize values as needed
# 3. Load and run:
#    source .env && ./start.sh
